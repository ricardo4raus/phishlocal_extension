{
  "name": "phishlocal",
  "version": "0.1.0",
  "private": true,
  "description": "On-device phishing checks for emails with Gemini Nano via Firebase AI Logic hybrid inference.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardo4raus/phishlocal_extension.git"
  },
  "license": "Apache-2.0",
  "author": "Ricardo Kraus",
  "dependencies": {
    "firebase": "^13.3.0",
    "parse5": "8.0.1",
    "postal-mime": "4.2.0",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
