# Normalize all text files to LF in the repo and in the working tree,
# regardless of core.autocrlf (keeps Prettier's endOfLine "lf" consistent on Windows).
* text=auto eol=lf

# Binary assets (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.crx binary
