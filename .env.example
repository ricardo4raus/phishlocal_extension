VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Development only. Secret: create it in the Firebase console (App Check > Apps > Manage debug
# tokens). Used by `npm run dev`; `npm run build` leaves it out of the bundle.
VITE_APPCHECK_DEBUG_TOKEN=

# Judges build only, in .env.judges.local (git-ignored). Secret: a second debug token made only for
# the judges, revoked after judging. Used by `npm run build:judges` (writes dist-judges/); never
# by `npm run build`.
# VITE_APPCHECK_JUDGES_TOKEN=
